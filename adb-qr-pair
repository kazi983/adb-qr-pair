#!/usr/bin/env bash
# adb-qr-pair — pair an Android 11+ phone for wireless debugging by QR code,
# then connect to it. One-shot, apt-only dependencies.
#
#   sudo apt install adb qrencode avahi-utils
#   ./adb-qr-pair            # default timeout 120 s
#   ADB_QR_TIMEOUT=60 ./adb-qr-pair
#
# Phone: Settings > Developer options > Wireless debugging >
#        Pair device with QR code  (same Wi-Fi as this PC)

set -euo pipefail

TIMEOUT="${ADB_QR_TIMEOUT:-120}"

red()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
dim()   { printf '\033[2m%s\033[0m\n' "$*"; }

# ---------- dependency checks ----------
missing=()
command -v adb          >/dev/null || missing+=(adb)
command -v qrencode     >/dev/null || missing+=(qrencode)
command -v avahi-browse >/dev/null || missing+=(avahi-utils)
if ((${#missing[@]})); then
  red "Missing: ${missing[*]}"
  echo "Install with:  sudo apt install ${missing[*]}" >&2
  exit 1
fi

if ! adb help 2>&1 | grep -q '^ *pair '; then
  red "Your adb ($(adb version | head -n1)) is too old: it has no 'adb pair'."
  echo "QR pairing needs adb 30.0.0 or newer (Ubuntu 24.04's apt package is fine)." >&2
  exit 1
fi

if ! avahi-browse -at -p >/dev/null 2>&1; then
  red "avahi-daemon is not running, so mDNS discovery can't work."
  echo "Start it with:  sudo systemctl enable --now avahi-daemon" >&2
  exit 1
fi

# ---------- helpers ----------
rand_alnum() { head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | cut -c1-"$1"; }

# Print "ip port" for the first resolved IPv4 service of TYPE whose
# field FIELD (4 = service name, 8 = address) equals VALUE.
find_service() {
  local type=$1 field=$2 value=$3
  timeout 6 avahi-browse -rpt "$type" 2>/dev/null |
    awk -F';' -v f="$field" -v v="$value" \
      '$1=="=" && $3=="IPv4" && $f==v { print $8, $9; exit }' || true
}

# Print the SSID of the Wi-Fi network this PC is on (empty if none).
current_ssid() {
  local line
  if command -v nmcli >/dev/null; then
    # Terse output escapes ':' as '\:' and '\' as '\\' inside the SSID.
    line=$(nmcli -t -f ACTIVE,SSID device wifi list --rescan no 2>/dev/null |
             grep -m1 '^yes:' || true)
    line=${line#yes:}
    line=${line//\\:/:}
    printf '%s' "${line//\\\\/\\}"
  elif command -v iwgetid >/dev/null; then
    iwgetid -r 2>/dev/null || true
  fi
}

deadline=$((SECONDS + TIMEOUT))

fail_with_hint() {
  red "$1"
  cat >&2 <<'EOF'

Things to check:
  • PC and phone are on the same Wi-Fi / subnet (not a guest network)
  • The router doesn't use "AP / client isolation"
  • A firewall isn't dropping mDNS:  sudo ufw allow 5353/udp

Manual fallback (no QR / no mDNS needed):
  1. On the phone: Wireless debugging > Pair device with pairing code
  2. On the PC:    adb pair <IP>:<PORT> <6-digit code>
  3. Then:         adb connect <IP>:<PORT shown on the main Wireless debugging screen>
EOF
  exit 1
}

trap 'echo; red "Cancelled."; exit 130' INT

# ---------- 1. show QR ----------
NAME="adbqr-$(rand_alnum 8)"
PASS="$(rand_alnum 10)"

echo
qrencode -t ANSIUTF8 -m 2 "WIFI:T:ADB;S:${NAME};P:${PASS};;"
ssid="$(current_ssid)"
if [[ -n $ssid ]]; then
  echo "PC Wi-Fi: ${ssid}  (phone must be on the same network)"
else
  echo "PC Wi-Fi: not connected (wired?) — phone must be on the same network/subnet"
fi
echo "Scan with: Developer options > Wireless debugging > Pair device with QR code"
dim "Waiting up to ${TIMEOUT}s for the phone…  (Ctrl-C to cancel)"

# ---------- 2. wait for the phone's pairing service ----------
pair_ip="" pair_port=""
while ((SECONDS < deadline)); do
  read -r pair_ip pair_port < <(find_service _adb-tls-pairing._tcp 4 "$NAME"; echo) || true
  [[ -n $pair_ip ]] && break
  sleep 1
done
[[ -n $pair_ip ]] || fail_with_hint "Timed out: the phone's pairing service never appeared."

echo "Found phone at ${pair_ip}:${pair_port}, pairing…"

# ---------- 3. pair ----------
if ! out=$(adb pair "${pair_ip}:${pair_port}" "$PASS" 2>&1) || ! grep -qi 'success' <<<"$out"; then
  echo "$out" >&2
  fail_with_hint "Pairing failed."
fi
green "Paired."

# ---------- 4. find the connect port and connect ----------
dim "Looking for the debug connection port…"
conn_ip="" conn_port=""
while ((SECONDS < deadline)); do
  read -r conn_ip conn_port < <(find_service _adb-tls-connect._tcp 8 "$pair_ip"; echo) || true
  [[ -n $conn_ip ]] && break
  sleep 1
done
[[ -n $conn_ip ]] || fail_with_hint "Paired, but timed out finding the phone's connect port."

out=$(adb connect "${conn_ip}:${conn_port}" 2>&1) || true
echo "$out"
if grep -qiE 'connected to|already connected' <<<"$out"; then
  green "Done. Device ready:"
  adb devices -l | grep -F "${conn_ip}:${conn_port}" || adb devices -l
else
  fail_with_hint "adb connect to ${conn_ip}:${conn_port} failed."
fi
